# Base URL of the FastAPI backend (Cognito auth wrapper + booking/payment services)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set to true to run the UI fully in-browser against mock data (no backend needed).
# Register/login work with any email+password, courts/bookings/payments are stored
# in localStorage. Set to false once the real FastAPI backend is running.
VITE_USE_MOCK_API=true
